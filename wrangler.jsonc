{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ognjen-portfolio",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "PORTFOLIO_WRITING_FEED",
      "id": "26730b417fa04d489d8265879260a666"
    }
  ],
  "routes": [
    {
      "pattern": "ognjenadzic.com",
      "custom_domain": true
    },
    {
      "pattern": "www.ognjenadzic.com",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
